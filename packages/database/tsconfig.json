{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File Layout
    "rootDir": "./drizzle/src", // to include drizzle.config.ts too at ./
    "outDir": "./dist",
    "target": "esnext", // "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],

    // Other Outputs
    "composite": true,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Style Options
    // "noImplicitReturns": true,
    // "noImplicitOverride": true,
    // "noUnusedLocals": true,  // => useful after development
    // "noUnusedParameters": true,  // => useful after development
    // "noFallthroughCasesInSwitch": true,
    // "noPropertyAccessFromIndexSignature": true,

    // Recommended Options
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
  },
  
  // include = tells ts compiler, tsc, which specific files or folders its allowed to look at & compile 
  // "include": ["src/**/*.ts", "drizzle.config.ts"]
  "include": ["drizzle/src/**/*.ts"] // => dosent need drizzle.config.ts to be compiled to js, its a config file nor source code, and drizzle.config.ts handled alone speeratedly by drizzle-kit nativelyw/o needing tsc to compile it
}
