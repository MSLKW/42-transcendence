{
	"compilerOptions": {
		"target": "esnext",
		"module": "esnext",
		"moduleResolution": "bundler",
		"types": ["node"],
		"rootDir": "./src", 
		"outDir": "./dist", 
		"esModuleInterop": true,
		"strict": true,
		"skipLibCheck": true,
		// "composite": true,
		"composite": false,
		"sourceMap": true,
		"declaration": true,
		"declarationMap": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"noUncheckedSideEffectImports": true,
		"moduleDetection": "force"
	},
	"include": ["src/**/*.ts"]
	// "references": [ // this is for tsc -b
	// 	{ "path": "../auth-schema" },
	// 	{ "path": "../../types/profile-system-types" }
	// ]
}