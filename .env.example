# root .env - defines global infrastructure

# DOCKER
PROJECT_NAME=your_project_name
MAIN_NETWORK_NAME=your_project_network_name
DB_NETWORK_NAME=your_database_network_name
INTERNAL_BACKEND_NETWORK_NAME=your_internal_backend_network_name
LOBBY_NETWORK_NAME=your_lobby_network_name
LOCALHOST=127.0.0.1

# POSTGRES
PG_PORT=your_postgres_port
PG_HOST=your_postgres_host
PG_DB_NAME=your_postgres_db_name
PG_VOLUME_NAME=your_postgres_volume_name
PG_MAX_CONNECTIONS=20 # Sometimes you need to tune this for performance as your app grows.
#    postgres users
PG_USER=your_postgres_admin_username--orm_itself_will_be_the_admin
PG_USER_AUTH=your_postgres_auth_username
PG_USER_PARTY_MANAGER=your_postgres_party-manager_username
PG_USER_PROFILE_SYSTEM=your_postgres_profile-system_username
PG_USER_GAME=your_postgres_game_username

# MIGRATOR

# DRIZZLE-GATEWAY
DRIZZLE_GATEWAY_PORT=your_drizzle_gateway_port
DG_VOLUME_NAME=your_drizzle_gateway_volume_name

# AUTHENTICATION

# PARTY_MANAGER
PARTY_MANAGER_PORT=your_party-manager_port
GAME_SERVICE_URL=http://game-service:port_number
AUTH_SERVICE_URL=http://auth-service:port_number

# NGINX
NGINX_PORT_HTTPS=443
NGINX_PORT_HTTP=80

# WEBSITE
WEBSITE_VOLUME_NAME=your_website_volume_name

# PROFILE_SYSTEM 

# GAME

# BOT

# CHAT

