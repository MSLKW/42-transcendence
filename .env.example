# Docker Compose's special .env file (the default one auto-loaded from the project root, not an env_file: you reference per-service),
	# does support nested interpolation, a widely used pattern.
# BUT, this interpolation behavior is specific to the top-level .env file that Compose auto-loads.

# DOCKER (NAME)
PROJECT_NAME=project_name

# DOCKER (NETWORK)
MAIN_NETWORK=main_network_name
DB_NETWORK=database_network_name

# DOCKER (VOLUMES)
PG_VOLUME=pg_volume_name
DG_VOLUME=dg_volume_name
WEBSITE_VOLUME=website_volume_name
PROFILE_AVATARS_VOLUME=profile_avatars_volume_name

# POSTGRES (psql's recognized variable naming convention)
PGPORT=5432
PGHOST=docker_postgresql_container_name

PGDATABASE=pg_database_name
PGUSER=pg_admin_username

# POSTGRES (SCHEMA USERS - not following normal variable naming convention)
PGUSER_AUTH=pg_auth_username
PGUSER_PARTY=pg_party_username
PGUSER_PROFILE=pg_profile_username
PGUSER_GAME_STATS=pg_game_stats_username
PGUSER_FRIENDS=pg_friends_username

# MIGRATOR
PG_MAX_CONNECTIONS=20


# DRIZZLE-GATEWAY
LOCALHOST=127.0.0.1
DRIZZLE_GATEWAY_PORT=4983

# NGINX
DOMAIN_PORT=80
# HTTPS_PORT=443

# WEBSITE
WEBSITE_SERVICE_PORT=port
WEBSITE_SERVICE_URL=http://docker_container_name:${WEBSITE_SERVICE_PORT}

# AUTHENTICATION
AUTH_SERVICE_PORT=port
AUTH_SERVICE_URL=http://docker_container_name:${AUTH_SERVICE_PORT}
AUTH_SERVICE_SESSION_DURATION_MS=86400000
#Setting AUTH_SERVICE_SESSION_DURATION_MS to 86400000, coz 1000 * 60 * 60 * 24 reaches Node as a string.
AUTH_SERVICE_SESSION_CLEANUP_CRON_SCHEDULE_STRING=*/5 * * * *

# PARTY
PARTY_SERVICE_PORT=port
PARTY_SERVICE_URL=http://docker_container_name:${PARTY_SERVICE_PORT}

# PROFILE
PROFILE_SERVICE_PORT=port
PROFILE_SERVICE_URL=http://docker_container_name:${PROFILE_SERVICE_PORT}
PROFILE_SERVICE_AVATAR_DIR=relative_path_to_avatar_dir

# FRIENDS
FRIENDS_SERVICE_PORT=port
FRIENDS_SERVICE_URL=http://docker_container_name:${FRIENDS_SERVICE_PORT}

# CHAT
CHAT_SERVICE_PORT=port
CHAT_SERVICE_URL=http://docker_container_name:${CHAT_SERVICE_PORT}
#/socket.io/

# GAME-STATS
GAME_STATS_SERVICE_PORT=port
GAME_STATS_SERVICE_URL=http://docker_container_name:${GAME_STATS_SERVICE_PORT}

# GAME-SERVER
GAME_SERVER_SERVICE_PORT=port
GAME_SERVER_SERVICE_URL=http://docker_container_name:${GAME_SERVER_SERVICE_PORT}

# GAME-BOT
GAME_BOT_SERVICE_PORT=port
GAME_BOT_SERVICE_URL=http://docker_container_name:${GAME_BOT_SERVICE_PORT}
