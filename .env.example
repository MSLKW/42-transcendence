# Docker Compose's special .env file (the default one auto-loaded from the project root, not an env_file: you reference per-service),
	# does support nested interpolation, a widely used pattern.
# BUT, this interpolation behavior is specific to the top-level .env file that Compose auto-loads.

# ===DOCKER (NAME)===
PROJECT_NAME=big2

# ===DOCKER (NETWORK)===
MAIN_NETWORK=${PROJECT_NAME}_main_network
DB_NETWORK=${PROJECT_NAME}_database_network

# ===DOCKER (VOLUMES)===
PG_VOLUME=pg_data
DG_VOLUME=dg_data
WEBSITE_VOLUME=website_data
PROFILE_AVATARS_VOLUME=avatars_data

# ===POSTGRES===
PGPORT=5432
PGHOST=postgresql
PGDATABASE=${PROJECT_NAME}_db
PGUSER=superuser_migrator
PGUSER_AUTH=auth-schema-user
PGUSER_PARTY=party-schema-user
PGUSER_PROFILE=profile-schema-user
PGUSER_GAME_STATS=game_stats-schema-user
PGUSER_FRIENDS=friends-schema-user

# ===MIGRATOR===
# Sometimes you need to tune this for performance as your app grows.
PG_POOL_MAX=10

# ===DRIZZLE-GATEWAY===
LOCALHOST=127.0.0.1
DRIZZLE_GATEWAY_PORT=4983

# ===NGINX===
DOMAIN_PORT=80
# HTTPS_PORT=443

# ===WEBSITE===
WEBSITE_SERVICE_PORT=5173
WEBSITE_SERVICE_URL=http://website:${WEBSITE_SERVICE_PORT}

# VITE_AUTH_API_URL=/api/auth
# VITE_PARTY_API_URL=/api/party
# VITE_PROFILE_API_URL=/api/profile
API_AUTH_PATH=/api/auth
API_PROFILE_PATH=/api/profile
API_PARTY_PATH=/api/party
API_FRIENDS_PATH=/api/friends
API_GAME_STATS_PATH=/api/game-stats
# API_GAME_SERVER_PATH=/api/game # MAY NOT BE USED IN PRODUCTION, yet included anywhere in docker compose 

SOCKET_CHAT_PATH=/socket/chat
SOCKET_PARTY_PATH=/socket/party
SOCKET_GAME_SERVER_PATH=/socket/game
SOCKET_GAME_BOT_PATH=/socket/game-bot

# VITE_CHAT_SOCKET_URL=http://localhost:${DOMAIN_PORT}
# VITE_PARTY_SOCKET_URL=http://localhost:${DOMAIN_PORT}
SOCKET_URL=http://localhost:${DOMAIN_PORT} # TODO: consult website PIC if they want to keep / opt out this in io.

# ===AUTHENTICATION===
AUTH_SERVICE_PORT=3000
AUTH_SERVICE_URL=http://authentication:${AUTH_SERVICE_PORT}
AUTH_SERVICE_SESSION_DURATION_MS=1000 * 60 * 60 * 24
AUTH_SERVICE_SESSION_CLEANUP_CRON_SCHEDULE_STRING=*/5 * * * *

# ===PARTY===
PARTY_SERVICE_PORT=3000
PARTY_SERVICE_URL=http://party:${PARTY_SERVICE_PORT}

# ===PROFILE===
PROFILE_SERVICE_PORT=3000
PROFILE_SERVICE_URL=http://profile:${PROFILE_SERVICE_PORT}
PROFILE_SERVICE_AVATAR_DIR=/app/data/avatars/

# ===FRIENDS===
FRIENDS_SERVICE_PORT=3000
FRIENDS_SERVICE_URL=http://friends:${FRIENDS_SERVICE_PORT}

# ===CHAT===
CHAT_SERVICE_PORT=3000
CHAT_SERVICE_URL=http://chat:${CHAT_SERVICE_PORT}

# ===GAME-SERVER===
GAME_SERVER_SERVICE_PORT=3000
GAME_SERVER_SERVICE_URL=http://game-server:${GAME_SERVER_SERVICE_PORT}

# ===GAME-BOT===
GAME_BOT_SERVICE_PORT=3000
GAME_BOT_SERVICE_URL=http://game-bot:${GAME_BOT_SERVICE_PORT}

# ===GAME-STATS===
GAME_STATS_SERVICE_PORT=3000
GAME_STATS_SERVICE_URL=http://game-stats:${GAME_STATS_SERVICE_PORT}
