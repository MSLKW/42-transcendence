{
  "name": "big2",
  "private": true,
  "type": "module",
  "workspaces": [
    "infra/*",
    "packages/*/*",
    "services/*"
  ],
  "scripts": {
    "db:generate":    "npm run db:generate -w migrator --",
    "db:migrate":     "npm run db:migrate -w migrator",
    "db:push":        "npm run db:push -w migrator",
    "test:signup":    "npm run test:signup -w authentication",
    "test:signin":    "npm run test:signin -w authentication",
    "test:logout":    "npm run test:logout -w authentication",
    "test:validate":  "npm run test:validate -w authentication",
    "test:guest":     "npm run test:guest -w authentication",
    "build":          "npm run build -w --if-present",
    "dev":            "npm run dev -w --if-present",
    "lint":           "eslint .",
    "format":         "prettier --write ."
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^9.0.0",
    "eslint-plugin-import-x": "^4.17.1",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  }
}
