{
  "name": "big2",
  "private": true,
  "workspaces":[
    "infra/*",
    "packages/*",
    "backend/*",
    "frontend/*"
  ],
  "scripts": {
    "db:generate": "npm run --prefix packages/migrator db:generate --",
    "db:migrate": "npm run --prefix packages/migrator db:migrate",
    "db:push": "npm run --prefix packages/migrator db:push",
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies":{
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  }
}