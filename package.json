{
  "name": "big2",
  "private": true,
  "workspaces":[
    "infra/*",
    "packages/*/*",
    "services/*"
  ],
  "scripts": {
    "db:generate": "npm run --prefix infra/migrator db:generate --",
    "db:migrate": "npm run --prefix infra/migrator db:migrate",
    "db:push": "npm run --prefix infra/migrator db:push",

    "test:signup": "services/authentication/scripts/test-signup.sh",
    "test:signin": "services/authentication/scripts/test-signin.sh",
    "test:logout": "services/authentication/scripts/test-logout.sh",
    "test:validate": "services/authentication/scripts/test-validate.sh",
    "test:guest": "services/authentication/scripts/test-guest.sh",

    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies":{
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  }
}