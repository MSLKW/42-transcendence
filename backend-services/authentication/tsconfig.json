{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"outDir": "./dist",
		"rootDir": "./src",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"types": ["node"],
		"incremental": true,
		"tsBuildInfoFile": "./.tsbuildinfo",
		"paths": {
			"@big2/database/*": ["../../packages/database/src/*"]
		} 
	},
	"include": ["src/**/*.ts"]
}
