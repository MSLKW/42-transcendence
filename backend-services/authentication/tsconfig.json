{
	"compilerOptions": {
		"target": "ES2022",
		"module": "esnext",
		"moduleResolution": "bundler",
		"outDir": "./dist",
		"rootDir": "./src",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"types": ["node"],
		"incremental": true,
		"tsBuildInfoFile": "./.tsbuildinfo",
		"paths": {
			"@big2_monorepo/database": ["../../packages/database/src/auth.schema.ts"]		} 
	},
	"include": ["src/**/*.ts"],
	"references": [
		{ "path": "../../packages/database" }
	]
}
