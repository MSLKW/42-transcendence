{
	"compilerOptions": {
		"target": "ES2022",
		"module": "esnext",
		"moduleResolution": "bundler",
		"outDir": "./dist",
		"rootDir": "./src",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"types": ["node"],
		"incremental": true,
		"tsBuildInfoFile": "./.tsbuildinfo",
		"paths": {
			"@big2/database": ["../../packages/database/dist/drizzle/src/schema/auth.schema.d.ts"]		} 
	},
	"include": ["src/**/*.ts"],
	"references": [
		{ "path": "../../packages/database" }
	]
}
