generator client {
  provider = "prisma-client-js"
  //output   = "./generated"      // if needed only - Tell Prisma to generate files here
}

datasource db {
  provider = "postgresql"
  // The url field is NO LONGER SUPPORTED here in Prisma 7
  // url      = env("DATABASE_URL")
}

model User {
  id                  String      @id @default(uuid())
  email               String      @unique
  username            String?     @unique
  passwordHash        String
  createdAt           DateTime    @default(now()) // auto sets time on creation
  failedLoginAttempts Int         @default(0)     // Starts at 0
  lockedUntil         DateTime?   
  sessions            Session[] // many(Session) to one(user) relationship, defined by array, []
}

model Session {
  token     String    @id @default(uuid())
  userId    String    // many(Session) to one(User) relationship, defined by not making it unique
  createdAt DateTime  @default(now())   // Should default to now()
  expiresAt DateTime  
  
  user      User      @relation(fields: [userId], references: [id]) // "many-to-one" relationship (one user can have many sessions).
  @@index([userId]) // Improves performance for lookups  
}
