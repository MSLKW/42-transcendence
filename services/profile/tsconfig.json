{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"outDir": "./dist",
		"rootDir": "./src",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"types": ["node"],
		// //
		// // previously added by aisyah, will cleanup later
		// "isolatedModules": true,
		// "moduleDetection": "force",
		// // "verbatimModuleSyntax": true,
		// "noUncheckedSideEffectImports": true,
		// "outDir": "./dist",
		// "rootDir": "./src",
		// //
		"incremental": true,
		"tsBuildInfoFile": "./.tsbuildinfo"
	},
	"include": ["src/**/*.ts"],
	"references": [
		{ "path": "../../packages/types/profile-types"},
		{ "path": "../../packages/postgres/profile-schema"},
		{ "path": "../../packages/postgres/postgres-client"}
	]
}
