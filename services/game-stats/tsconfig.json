{
	"compilerOptions": {
		"target": "esnext",
		"module": "esnext",
		"moduleResolution": "bundler",
		"outDir": "./dist",
		"rootDir": "./src",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"types": ["node"],
		"incremental": true,
		"tsBuildInfoFile": "./.tsbuildinfo"
	},
	"include": ["src/**/*.ts"],
	"references": [
		{ "path": "../../packages/types/badge-types"},
		{ "path": "../../packages/types/game-stats-types"},
		{ "path": "../../packages/postgres/game-stats-schema"},
		{ "path": "../../packages/postgres/postgres-client"}
	 ]
}