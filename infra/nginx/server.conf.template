resolver 127.0.0.11 valid=10s ipv6=off;

map $http_upgrade $connection_upgrade {
	default	upgrade;
	''		'';
}

server {
	listen ${DOMAIN_PORT} default_server;

	# hoisting what every location has in common
	proxy_http_version			1.1;
	proxy_set_header Upgrade	$http_upgrade;
	proxy_set_header Connection	$connection_upgrade;
	#proxy_set_header Host 		$host;					# if needed and harmless to every services only. only placing here as an possible option to consider in future, discuss first. 

	# Used by the docker healthcheck via dockerfile. Answered by nginx itself, no backend involved.
    location = /health {							# '=' means exact match
        default_type text/plain;
        return 200 "ok\n";
    }

	location / {
		set $upstream ${WEBSITE_SERVICE_URL};
		proxy_pass $upstream;						# no rewrite: original URI is passed as-is
	}

	location ${API_AUTH_PATH}/ {
		set $upstream ${AUTH_SERVICE_URL};
        rewrite ^${API_AUTH_PATH}/(.*)$ /$1 break;          # /api/auth/signup -> (signup) -> /signup
		proxy_pass $upstream;
	}

	location ${API_PROFILE_PATH}/ {
		set $upstream ${PROFILE_SERVICE_URL};
        rewrite ^${API_PROFILE_PATH}/(.*)$ /$1 break;
		proxy_pass $upstream;
	}

	location ${API_PARTY_PATH}/ {
		set $upstream ${PARTY_SERVICE_URL};
        rewrite ^${API_PARTY_PATH}/(.*)$ /$1 break;
		proxy_pass $upstream;
	}

	# SSE, Server-Sent Events: do not buffer, keep the stream open
	location ${API_FRIENDS_PATH}/ {
		set $upstream ${FRIENDS_SERVICE_URL};
        rewrite ^${API_FRIENDS_PATH}/(.*)$ /$1 break;
		proxy_pass $upstream;

		proxy_set_header	Connection '';
		proxy_buffering		off;
		proxy_cache			off;
		proxy_read_timeout	2h; # how long nginx will wait for friends to send anything.
	}

# proxy_set_header is inherited from the level above only when the current level defines none. 
# Chat block adds Host, so it stops inheriting Upgrade and Connection, 
# and the WebSocket handshake would fail.
# Friends loses them too, but SSE doesn't need Upgrade
	location ${SOCKET_CHAT_PATH}/ {
		set $upstream ${CHAT_SERVICE_URL};
		proxy_pass $upstream;

		proxy_set_header Host		$host;
		proxy_set_header Upgrade	$http_upgrade;
		proxy_set_header Connection	$connection_upgrade;
		proxy_cache_bypass			$http_upgrade;
	}

	location ${SOCKET_PARTY_PATH}/ {
		set $upstream ${PARTY_SERVICE_URL};
        rewrite ^${SOCKET_PARTY_PATH}/(.*)$ /socket.io/$1 break;
		proxy_pass $upstream;
	}

	# # Temporary for direct website calling party
	# location /api/game/ {
	# 	set $upstream ${GAME_SERVER_SERVICE_URL};
    #     rewrite ^/api/game/(.*)$ /$1 break;
	# 	proxy_pass $upstream;
	# }

	location ${SOCKET_GAME_SERVER_PATH}/ {
		set $upstream ${GAME_SERVER_SERVICE_URL};
        rewrite ^${SOCKET_GAME_SERVER_PATH}/(.*)$ /socket.io/$1 break;
		proxy_pass $upstream;
	}

	#TO BE MERGED LATER, not completed yet
	location ${API_GAME_STATS_PATH}/ {
		set $upstream ${GAME_STATS_SERVICE_URL};
        rewrite ^${API_GAME_STATS_PATH}/(.*)$ /$1 break;
		proxy_pass $upstream;
	}

	#TO BE MERGED LATER, not completed yet
	location ${SOCKET_GAME_BOT_PATH}/ {
		set $upstream ${GAME_BOT_SERVICE_URL};
        rewrite ^${SOCKET_GAME_BOT_PATH}/(.*)$ /socket.io/$1 break;
		proxy_pass $upstream;
	}

	location /avatars/ {
		alias ${PROFILE_SERVICE_AVATAR_DIR};
	}
}
